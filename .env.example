# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored and must never be committed.

# --- Database (Neon) ---
# Neon dashboard → your project → Connection string (pooled)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Customer sign-in (NextAuth + Google) ---
# From Google Cloud Console → APIs & Services → Credentials
# Setup steps: GOOGLE_OAUTH_SETUP.md
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Any long random string. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
# http://localhost:3000 locally; the real URL in Vercel's env settings
NEXTAUTH_URL="http://localhost:3000"

# --- Admin sign-in (separate system, deliberately not NextAuth) ---
# Must be a DIFFERENT value from NEXTAUTH_SECRET — the two auth systems are
# kept independent on purpose (see ARCHITECTURE.md / HITL.md).
ADMIN_JWT_SECRET=""

# --- Image storage (Vercel Blob) ---
# Vercel dashboard → Storage → Blob → create store → read/write token
BLOB_READ_WRITE_TOKEN=""

# --- Seed data ---
# First super_admin, created by the seed script. Set the password once, then
# change it from inside the admin panel after first login.
SEED_SUPER_ADMIN_EMAIL="jkdtharindu@gmail.com"
SEED_SUPER_ADMIN_PASSWORD=""
